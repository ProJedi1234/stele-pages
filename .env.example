# Copy to .env and adjust. .env is gitignored; .env.example is not, so never put a
# real credential in this file.

# --- Database -----------------------------------------------------------------
# Local development, matching docker-compose.yml:
DATABASE_URL=postgres://stele:stele_dev_password@localhost:5432/stele
#
# Deployment against a real Postgres host. Create the role and database there first —
# see the "Deploying" section of the README:
# DATABASE_URL=postgres://stele:REPLACE_ME@DB_HOST:5432/stele
#
# Append ?sslmode=require if the connection ever leaves the LAN. Accepted values are
# the libpq ones: disable (default), prefer, allow, require, verify-ca, verify-full.

# --- Operator credential ------------------------------------------------------
# Required, no default. This is the *admin* credential: it gates /admin/clients and
# mints the per-client publishing tokens, and it can no longer publish a page itself.
# Keep it on the operator's machine, not in an agent's environment — see "Credentials"
# in the README.
# Generate with: openssl rand -hex 32
STELE_UPLOAD_TOKEN=

# --- GitHub sign-in -----------------------------------------------------------
# Comma-separated GitHub logins allowed to mint a publishing credential by signing
# in with GitHub. Matching is case-insensitive, as GitHub's own is.
# Absent or empty means NOBODY can: this fails closed rather than open, for the same
# reason STELE_UPLOAD_TOKEN has no default.
# It gates minting only — cutting off a credential someone already holds is a revoke,
# DELETE /admin/clients/:name.
STELE_GITHUB_OWNERS=

# The client ID of the GitHub OAuth app this deployment trusts (GitHub -> Settings ->
# Developer settings -> OAuth Apps). Not a secret, but load-bearing: this server runs the
# device flow on the client's behalf and is the only holder of the ID, so the CLI ships no
# copy of it and setting this hands the CLI nothing.
# Absent or empty means NOBODY can sign in, on the same fail-closed reasoning as the
# allowlist above — and the refusal is byte-for-byte the one every other refused sign-in
# gets, so the "github sign-in" line in the boot log is where it says which half is missing.
# Tick "Enable Device Flow" on the app's settings page: GitHub does not speak RFC 8628 to
# an app that has not opted in, and a sign-in against one that hasn't fails at GitHub
# rather than here. The callback URL the registration form demands is still never used —
# a device flow has no redirect in it.
STELE_GITHUB_CLIENT_ID=

# --- HTTP ---------------------------------------------------------------------
# Only read when the binary runs directly on the host (`swift run stele`). Under
# docker compose the container always listens on 0.0.0.0:8080 — set in the Dockerfile —
# and these two are ignored; move the published port in the compose `ports:` mapping.
# Defaults to loopback. Set 0.0.0.0 to accept connections from the LAN.
STELE_HOST=127.0.0.1
STELE_PORT=8080

# Origin used to build the URL returned by POST /pages. Cosmetic only.
STELE_BASE_URL=http://127.0.0.1:8080

# --- Behaviour ----------------------------------------------------------------
# 3 -> quiet-cedar-otter        (11,787,776 combinations)
# 4 -> quiet-mossy-cedar-otter  (2,982,307,328 combinations)
STELE_SLUG_WORDS=3

# Largest page accepted, in bytes. Default 1 MiB.
STELE_MAX_PAGE_BYTES=1048576

# Largest attachment (image, video, PDF) accepted, in bytes. Default 32 MiB.
# The process refuses to start above 128 MiB: bytes live in a Postgres bytea and an
# unranged read materialises a whole value, so a bigger number is an OOM rather than a
# more permissive setting.
STELE_MAX_ATTACHMENT_BYTES=33554432

# trace | debug | info | notice | warning | error | critical
STELE_LOG_LEVEL=info
